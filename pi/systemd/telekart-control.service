[Unit]
Description=TeleKart control process (motion, safety, networking)
Documentation=file:/home/pi/telekart/docs/pi-setup.md
After=network-online.target pigpiod.service
Wants=network-online.target
# Requires, not merely After. Without pigpiod the firmware cannot touch a pin
# and must not start pretending otherwise. It also fixes the *stop* ordering:
# `systemctl stop pigpiod` stops this unit first, so ExecStopPost still has a
# live daemon to send `pigs` commands to.
Requires=pigpiod.service

[Service]
# notify, not simple: WatchdogSec is only fed by sd_notify(WATCHDOG=1), and with
# Type=simple systemd would set NotifyAccess=none and discard every ping.
Type=notify
NotifyAccess=main
User=root
WorkingDirectory=/home/pi/telekart/pi
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TELEKART_BACKEND=pigpio
# Explicit rather than relying on `python -m` inserting the working directory,
# so the unit still starts if it is ever given a different WorkingDirectory.
Environment=PYTHONPATH=/home/pi/telekart/pi
# 0600, root-owned, not in git. This is how the shared key stays out of the
# repository and out of `systemctl show`. The leading '-' makes it optional so
# a car with the key in config.local.yaml still starts.
EnvironmentFile=-/etc/telekart/telekart.env
# pi/.venv, not <repo>/.venv: `make setup-pi` creates the firmware venv beside
# the package it installs, so that app/, pi/ and tools/ keep three separate
# environments on three different interpreters. Same directory as
# WorkingDirectory above.
ExecStart=/home/pi/telekart/pi/.venv/bin/python -m telekart

# ---------------------------------------------------------------------------
# Layer 2 of the four-layer panic stop.
#
# THIS IS THE ONLY LAYER THAT COVERS SIGKILL. Every in-process hook -- atexit,
# the signal handlers, sys.excepthook, threading.excepthook, the context manager
# around main() -- needs Python to still be running to fire. SIGKILL, a segfault
# and an OOM kill all leave pigpiod holding the last duty cycle it was given,
# with the motors turning, indefinitely. systemd runs ExecStopPost on EVERY stop
# path including those, and including every crash-restart cycle.
#
# The '-' prefix means a failure here can never block the stop transition or the
# restart that follows it.
# ---------------------------------------------------------------------------
ExecStopPost=-/usr/local/sbin/telekart-panic-stop

# The car restarts on a clean exit too, not only on failure: this process has no
# legitimate reason to stop while the vehicle is powered, so a clean exit is
# itself a symptom.
Restart=always
RestartSec=2
# systemd escalates to SIGKILL after this, and ExecStopPost still runs. That is
# the design, not a fallback.
TimeoutStopSec=5
KillSignal=SIGTERM
# Restarting forever at 2 s intervals is better than giving up on a vehicle, but
# a boot-time fault should not hide behind an infinite loop of restarts.
StartLimitIntervalSec=60
StartLimitBurst=10

# ---------------------------------------------------------------------------
# Watchdog
#
# 3 s against a 10 ms loop is 300 missed deadlines: nothing survivable trips it.
# The pings come from the CONTROL THREAD, not from the asyncio loop -- a
# watchdog fed by the event loop stays happy while the control loop is wedged
# with the motors at 60 % duty, which is the exact failure it exists to catch.
# On expiry systemd kills and restarts, and ExecStopPost safes the outputs on
# the way through.
# ---------------------------------------------------------------------------
WatchdogSec=3

# ---------------------------------------------------------------------------
# Scheduling
#
# The process starts at FIFO priority 10 and the control thread raises itself to
# 50 from inside Python, so the loop outranks its own networking thread while
# both outrank everything on CFS. Priority 10 is deliberately low: the asyncio
# thread inherits it, and a busy-spin at a high RT priority on a four-core board
# is a hung machine. The kernel's RT throttle (95 % by default) is the backstop.
#
# CPUAffinity 2-3 leaves cores 0-1 for the kernel's IRQ work, the WiFi stack and
# the camera process. telekart/constants.py pins the control thread further, to
# core 3 alone, which leaves core 2 for asyncio.
# ---------------------------------------------------------------------------
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=10
CPUSchedulingResetOnFork=yes
CPUAffinity=2-3
IOSchedulingClass=realtime
IOSchedulingPriority=2

# ---------------------------------------------------------------------------
# Memory
#
# 512 MB is genuinely tight and the kernel must take the camera, never the car.
# The unit sets -500; the process lowers itself to -900 at startup, which needs
# CAP_SYS_RESOURCE. Both, because the unit's value applies from exec and covers
# the window before Python has run a line.
# ---------------------------------------------------------------------------
OOMScoreAdjust=-500
OOMPolicy=stop

# CAP_SYS_NICE  -> sched_setscheduler(SCHED_FIFO) from the control thread
# CAP_IPC_LOCK  -> mlockall, so no page of the loop can be swapped mid-tick
# CAP_SYS_RESOURCE -> lowering oom_score_adj below the unit's value
# Redundant while User=root, and set anyway so moving to an unprivileged user
# later does not silently turn real-time scheduling off.
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_SYS_NICE CAP_IPC_LOCK CAP_SYS_RESOURCE CAP_NET_BIND_SERVICE
LimitRTPRIO=99
LimitMEMLOCK=infinity
LimitNICE=-20

[Install]
WantedBy=multi-user.target
