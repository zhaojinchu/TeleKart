[Unit]
Description=TeleKart video process (camera capture, H.264, frame stream)
Documentation=file:/home/pi/telekart/docs/pi-setup.md
After=network-online.target telekart-control.service
Wants=network-online.target
# After, deliberately NOT Requires. Video failing must never take the control
# process down with it: a car with no picture is recoverable, a car with no
# control loop is not.

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/telekart/pi
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/home/pi/telekart/pi
EnvironmentFile=-/etc/telekart/telekart.env
# pi/.venv, not <repo>/.venv -- see the note in telekart-control.service.
ExecStart=/home/pi/telekart/pi/.venv/bin/python -m telekart_video.app

Restart=on-failure
RestartSec=5
TimeoutStopSec=5

# No ExecStopPost. This process touches no GPIO, so there is nothing to safe.
# No Requires=pigpiod.service, for the same reason.

# ---------------------------------------------------------------------------
# The whole point of running the camera in its own process.
#
# MemoryMax caps the cgroup, and OOMPolicy=continue means that when the encoder
# leaks or a resolution change asks for more than the board has, the kernel
# kills THIS process and systemd restarts it -- while the control loop, which is
# steering a moving vehicle, never notices. Without the cap the two processes
# compete for the same 512 MB and the OOM killer chooses by heuristic.
#
# 220 MB is about three times a steady-state 640x480 H.264 pipeline, which
# leaves room for a resolution bump without leaving room for a runaway.
# ---------------------------------------------------------------------------
MemoryMax=220M
MemoryHigh=180M
OOMPolicy=continue
# The counterpart to the control unit's -500: this is the process the kernel is
# meant to take.
OOMScoreAdjust=500

# Explicitly below the control loop, and on the two cores the control unit does
# not use. Camera work must not be able to inject jitter into a 10 ms deadline.
Nice=5
CPUSchedulingPolicy=other
CPUAffinity=0-1

# No DeviceAllow= here on purpose. Setting even one entry switches the unit's
# device policy from 'auto' to 'closed', and the libcamera stack reaches for
# /dev/video*, /dev/media*, /dev/dma_heap/* and /dev/dri/* -- an incomplete list
# presents as "the camera does not work" with no useful error. Sandbox the
# camera by memory and CPU, which is what actually protects the control loop.

[Install]
WantedBy=multi-user.target
